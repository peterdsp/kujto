<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kujto Runtime Helper launch plist.

  Copied into KujtoStudio.app/Contents/Library/LaunchDaemons/ by the
  KujtoRuntimeHelper build phase. SMAppService reads it when the app calls
  register() and installs the daemon under /Library/LaunchDaemons/ managed
  by launchd.

  MachServices key is what NSXPCListener(machServiceName:) binds against.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.peterdsp.kujto.runtime</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/kujto-runtime-helper</string>

    <key>MachServices</key>
    <dict>
        <key>dev.peterdsp.kujto.runtime</key>
        <true/>
    </dict>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>dev.peterdsp.kujto.studio</string>
    </array>
</dict>
</plist>
